.sr-only
  sr-only()

.container
  margin-right: auto
  margin-left: auto
  width: 100%
  max-width: var(--container-page)
  padding-right: var(--gutter)
  padding-left: var(--gutter)

// Font size only, not t-xs(): the line-height is inherited and each surface sets the colour.
.eyebrow
  font-size: var(--text-xs)
  font-weight: 600
  letter-spacing: 0.14em
  text-transform: uppercase

@keyframes cart-pulse
  50%
    scale: 1.25
