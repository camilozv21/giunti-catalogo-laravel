.login
  &__button
    +mq-below(xl)
      width: 2.75rem
      height: 2.75rem
      padding-right: 0
      padding-left: 0

  &__label
    +mq-below(xl)
      sr-only()

  &__note
    position: fixed
    inset: auto
    top: calc(var(--header-height) + 0.75rem)
    right: var(--gutter)
    margin: 0
    width: 18rem
    border-radius: var(--radius-lg)
    border: 1px solid var(--color-border-soft)
    background-color: var(--color-surface)
    padding: 1rem
    t-sm()
    color: var(--color-ink)
    box-shadow: var(--shadow-card-hover)

  &__note-text
    display: flex
    gap: 0.625rem

  &__note-icon
    margin-top: 0.125rem
    color: var(--color-primary)

.cart-button
  position: relative

  &__count
    position: absolute
    top: 0.25rem
    right: 0.125rem
    min-width: 1.25rem
    border-radius: var(--radius-pill)
    background-color: var(--color-accent)
    padding-right: 0.25rem
    padding-left: 0.25rem
    text-align: center
    font-size: 0.6875rem
    line-height: 1.25rem
    font-weight: 700
    color: var(--color-ink)
    &.is-pulsing
      +motion-safe()
        animation: cart-pulse 300ms var(--ease-standard)
