// Shown and hidden by the motion layer (.fab, .fab[data-hidden]).
.demo-fab
  position: fixed
  right: 1rem
  bottom: unquote('max(1rem, env(safe-area-inset-bottom))')
  z-index: 30
  display: inline-flex
  min-height: 3rem
  align-items: center
  gap: 0.5rem
  border-radius: var(--radius-pill)
  background-color: var(--color-accent)
  padding-right: 1.25rem
  padding-left: 1.25rem
  t-sm()
  font-weight: 700
  color: var(--color-ink-deep)
  box-shadow: var(--shadow-fab)
  +hover()
    background-color: var(--color-accent-soft)
  +mq(md)
    right: 1.5rem
    bottom: 1.5rem
