// Each format differs by fill, icon and label, never by colour alone.
.badge
  display: inline-flex
  align-items: center
  gap: 0.375rem
  border-radius: var(--radius-pill)
  padding: 0.25rem 0.625rem
  t-xs()
  font-weight: 600
  box-shadow: $shadow-sm

  &--cartaceo
    background-color: var(--color-surface)
    color: var(--color-ink)
    box-shadow: inset 0 0 0 1px var(--color-ink), $shadow-sm

  &--digitale
    background-color: var(--color-sky-tint)
    color: var(--color-ink)
    box-shadow: inset 0 0 0 1px rgba(27, 79, 138, 0.4), $shadow-sm

  &--corso-online
    background-color: var(--color-ink)
    color: var(--color-accent)

  &--in-presenza
    background-color: var(--color-primary)
    color: #fff
