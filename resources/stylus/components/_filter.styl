// Native radios keep arrow keys and "1 of 5": the invisible input covers the whole pill.
.filter
  min-width: 0

  &__row
    margin-right: calc(var(--gutter) * -1)
    margin-left: calc(var(--gutter) * -1)
    display: flex
    scroll-snap-type: x proximity
    gap: 0.5rem
    overflow-x: auto
    padding-right: var(--gutter)
    padding-bottom: 0.25rem
    padding-left: var(--gutter)
    scrollbar-width: none
    +mq(md)
      margin-right: 0
      margin-left: 0
      flex-wrap: wrap
      overflow: visible
      padding-right: 0
      padding-left: 0

  &__pill
    position: relative
    display: inline-flex
    min-height: 2.75rem
    flex-shrink: 0
    cursor: pointer
    scroll-snap-align: start
    align-items: center
    gap: 0.5rem
    border-radius: var(--radius-pill)
    border: 1px solid var(--color-border-control)
    background-color: var(--color-surface)
    padding-right: 1rem
    padding-left: 1rem
    t-sm()
    font-weight: 600
    white-space: nowrap
    color: var(--color-ink)
    transition-colors()
    +hover()
      border-color: var(--color-primary)
      background-color: var(--color-primary-tint)
    &:has(:checked)
      border-color: var(--color-ink)
      background-color: var(--color-ink)
      color: #fff
      +hover()
        border-color: var(--color-ink)
        background-color: var(--color-ink)
    &:has(:focus-visible)
      outline: 2px solid var(--color-primary)
      outline-offset: 2px

  &__input
    position: absolute
    inset: 0
    cursor: pointer
    appearance: none
    border-radius: var(--radius-pill)
    opacity: 0

  &__count
    border-radius: var(--radius-pill)
    background-color: var(--color-primary-tint)
    padding-right: 0.375rem
    padding-left: 0.375rem
    t-xs()
    line-height: 1.25rem
    font-variant-numeric: tabular-nums
    color: var(--color-primary)
    ^[0]__pill:has(:checked) &
      background-color: rgba(255, 255, 255, 0.15)
      color: #fff
