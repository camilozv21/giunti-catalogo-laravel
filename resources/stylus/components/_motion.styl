// Mirrors the Next.js version: change both together.
@css {
/* Registered so keyframes can interpolate them; unregistered custom properties flip at 50%. */
@property --count {
  syntax: "<integer>";
  inherits: false;
  initial-value: 0;
}

@property --fill {
  syntax: "<percentage>";
  inherits: false;
  initial-value: 100%;
}

@property --angle {
  syntax: "<angle>";
  inherits: false;
  initial-value: 0deg;
}

/* On dark surfaces the primary ring is under 2:1; the accent clears the 3:1 focus-indicator minimum. */
.on-dark :focus-visible {
  outline-color: var(--color-accent);
}

/* Named so the sticky header keeps its own snapshot above the morphing cards. */
.site-header {
  view-transition-name: site-header;
}

.site-header::after {
  content: "";
  position: absolute;
  right: 0;
  bottom: -1px;
  left: 0;
  height: 2px;
  background: linear-gradient(90deg, var(--color-primary), var(--color-accent));
  transform-origin: 0 50%;
  scale: 0 1;
  pointer-events: none;
}

.hero-shade {
  position: absolute;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  background:
    linear-gradient(0deg, rgba(10, 33, 64, 0.94) 0%, rgba(10, 33, 64, 0.62) 34%, rgba(10, 33, 64, 0.12) 64%, rgba(10, 33, 64, 0) 82%),
    linear-gradient(90deg, rgba(10, 33, 64, 0.6) 0%, rgba(10, 33, 64, 0) 58%);
}

.hero-title__line {
  display: block;
}

.hero-title__word {
  display: inline-block;
}

.hero-mark {
  color: var(--color-accent);
  background-image: linear-gradient(var(--color-accent), var(--color-accent));
  background-repeat: no-repeat;
  background-position: 0 94%;
  background-size: 100% 0.075em;
  -webkit-box-decoration-break: clone;
  box-decoration-break: clone;
}

.count {
  --count: var(--to, 0);
  counter-reset: count var(--count);
  font-variant-numeric: tabular-nums;
}

.count::before {
  content: counter(count, decimal-leading-zero);
}

[data-grid] > li {
  view-transition-class: card;
}

::view-transition-group(.card) {
  animation-duration: 520ms;
  animation-timing-function: var(--ease-out-expo);
}

::view-transition-new(.card):only-child {
  animation: card-enter 460ms var(--ease-out-expo) both;
}

::view-transition-old(.card):only-child {
  animation: card-leave 240ms ease-in both;
}

::view-transition-old(root),
::view-transition-new(root) {
  animation-duration: 220ms;
}

.product-card {
  position: relative;
}

.fab {
  transition:
    opacity 200ms var(--ease-standard),
    translate 200ms var(--ease-standard),
    visibility 0s linear 0s;
}

.fab[data-hidden] {
  opacity: 0;
  translate: 0 1rem;
  visibility: hidden;
  transition-delay: 0s, 0s, 200ms;
}

.cta-flood {
  position: relative;
  isolation: isolate;
  overflow: hidden;
}

.cta-flood::before {
  content: "";
  position: absolute;
  z-index: -1;
  top: 50%;
  right: 1.75rem;
  width: 0.5rem;
  height: 0.5rem;
  border-radius: 9999px;
  background-color: #fff;
  translate: 50% -50%;
  scale: 0;
  transition: scale 450ms var(--ease-standard);
}

.cta-flood svg {
  transition: translate 300ms var(--ease-spring);
}

@media (hover: hover) {
  .cta-flood:hover {
    background-color: var(--color-accent);
  }

  .cta-flood:hover::before {
    scale: 60;
  }

  .cta-flood:hover svg {
    translate: 0 3px;
  }
}

.cta-flood:focus-visible::before {
  scale: 60;
}

.cta-flood:focus-visible svg {
  translate: 0 3px;
}

/* clip, not hidden: a scroll container here would capture the bar's view() timeline. */
.reach-track {
  height: 0.5rem;
  overflow: clip;
  border-radius: 999px;
  background-color: var(--color-primary-tint);
}

.reach-bar {
  display: block;
  height: 100%;
  width: calc(var(--level, 0) * 100%);
  border-radius: 999px;
  background: linear-gradient(90deg, var(--color-primary), var(--color-accent));
  transform-origin: 0 50%;
}

.glow-border {
  position: relative;
  isolation: isolate;
}

.glow-border::before {
  content: "";
  position: absolute;
  inset: -1px;
  z-index: -1;
  border-radius: inherit;
  padding: 2px;
  background: conic-gradient(from var(--angle), transparent 0 55%, var(--color-accent) 78%, var(--color-primary) 90%, transparent 100%);
  -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
  -webkit-mask-composite: xor;
  mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
  opacity: 0;
  pointer-events: none;
  transition: opacity 400ms var(--ease-standard);
}

.glow-border:focus-within::before {
  opacity: 1;
}

.mega-tagline {
  --fill: 100%;
  font-family: var(--font-display);
  font-size: clamp(2.75rem, 0.6rem + 8.6vw, 9.25rem);
  font-weight: 600;
  line-height: 0.92;
  letter-spacing: -0.045em;
  padding-bottom: 0.18em;
  color: transparent;
  -webkit-text-stroke: 1px rgba(191, 219, 254, 0.4);
  background: linear-gradient(90deg, #fff 20%, var(--color-accent)) 0 0 / var(--fill) 100% no-repeat;
  -webkit-background-clip: text;
  background-clip: text;
}

.reveal-word {
  color: #fff;
}

.coverage-track {
  position: relative;
  height: 0.625rem;
  border-radius: 999px;
  background:
    repeating-linear-gradient(90deg, rgba(191, 219, 254, 0.22) 0 1px, transparent 1px 20%),
    rgba(255, 255, 255, 0.06);
}

.coverage-bar {
  position: absolute;
  top: 0;
  bottom: 0;
  left: calc(var(--from) * 1%);
  width: calc((var(--to) - var(--from)) * 1%);
  border-radius: 999px;
  background: linear-gradient(90deg, var(--color-accent-soft), var(--color-accent));
  box-shadow: 0 0 14px rgba(14, 165, 233, 0.35);
  transform-origin: 0 50%;
}

.span-ruler {
  position: relative;
  height: 2.25rem;
  border-bottom: 1.5px solid rgba(191, 219, 254, 0.35);
  background:
    repeating-linear-gradient(90deg, rgba(191, 219, 254, 0.45) 0 1.5px, transparent 1.5px calc(100% / 9)) 0 100% / 100% 0.875rem no-repeat,
    repeating-linear-gradient(90deg, rgba(191, 219, 254, 0.2) 0 1px, transparent 1px calc(100% / 18)) 0 100% / 100% 0.45rem no-repeat;
}

.span-ruler__range {
  position: absolute;
  bottom: -3px;
  left: calc(var(--from) / var(--scale) * 100%);
  width: calc((var(--to) - var(--from)) / var(--scale) * 100%);
  height: 6px;
  border-radius: 999px;
  background: linear-gradient(90deg, var(--color-accent-soft), var(--color-accent));
  box-shadow: 0 0 18px rgba(14, 165, 233, 0.55);
  transform-origin: 0 50%;
}

.search-popup {
  position: absolute;
  top: calc(100% + 0.5rem);
  right: 0;
  left: 0;
  z-index: 50;
  max-height: min(70vh, 26rem);
  overflow-y: auto;
  overscroll-behavior: contain;
  border: 1px solid var(--color-border-soft);
  border-radius: 1rem;
  background: var(--color-surface);
  padding: 0.375rem;
  box-shadow: var(--shadow-card-hover);
}

.product-card[data-highlight] {
  outline: 3px solid var(--color-accent);
  outline-offset: 4px;
}

.chat {
  position: relative;
  display: flex;
  min-height: 31rem;
  flex-direction: column;
  overflow: clip;
  border: 1px solid rgba(191, 219, 254, 0.14);
  border-radius: 1.5rem;
  background: var(--color-ink-deep);
  box-shadow: 0 40px 80px -40px rgba(15, 45, 82, 0.65);
  color: #fff;
}

.chat__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  border-bottom: 1px solid rgba(191, 219, 254, 0.1);
  padding: 0.875rem 1.25rem;
  font-size: 0.6875rem;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--color-ink-muted);
}

.chat__live {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
}

.chat__live::before {
  content: "";
  width: 0.5rem;
  height: 0.5rem;
  border-radius: 999px;
  background: var(--color-accent);
  box-shadow: 0 0 0 4px rgba(14, 165, 233, 0.22);
}

.chat__status {
  border-radius: 999px;
  padding: 0.25rem 0.625rem;
  background: rgba(255, 255, 255, 0.06);
  letter-spacing: 0;
  text-transform: none;
  color: var(--color-accent-soft);
}

.chat__log {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 0.75rem;
  padding: 1.25rem;
}

.chat__msg {
  max-width: 88%;
  border-radius: 1rem;
  padding: 0.75rem 1rem;
  font-size: 0.9375rem;
  line-height: 1.5;
}

.chat__msg--user {
  align-self: flex-end;
  border-bottom-right-radius: 0.375rem;
  background: var(--color-primary);
}

.chat__msg--bot {
  align-self: flex-start;
  border: 1px solid rgba(191, 219, 254, 0.12);
  border-bottom-left-radius: 0.375rem;
  background: rgba(255, 255, 255, 0.06);
}

.chat__typing {
  display: inline-flex;
  align-items: center;
  gap: 0.625rem;
  color: var(--color-ink-muted);
}

.chat__dots {
  display: inline-flex;
  gap: 0.25rem;
}

.chat__dots span {
  width: 0.375rem;
  height: 0.375rem;
  border-radius: 999px;
  background: var(--color-ink-muted);
}

.chat__results {
  margin-top: 0.75rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.chat__result {
  display: grid;
  grid-template-columns: 6.5rem minmax(0, 1fr);
  align-items: center;
  column-gap: 0.75rem;
  border: 1px solid rgba(191, 219, 254, 0.12);
  border-radius: 0.75rem;
  background: rgba(10, 33, 64, 0.65);
  padding: 0.625rem 0.75rem;
}

.chat__result-code {
  grid-row: span 2;
  white-space: nowrap;
  font-family: var(--font-display);
  font-size: 1rem;
  font-weight: 600;
  line-height: 1.2;
  color: var(--color-accent-soft);
}

.chat__result-name {
  overflow: hidden;
  font-size: 0.8125rem;
  font-weight: 600;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chat__result-meta {
  font-size: 0.75rem;
  line-height: 1.4;
  color: var(--color-ink-muted);
}

.chat__meta {
  margin-top: 0.625rem;
  font-size: 0.6875rem;
  color: var(--color-accent-soft);
}

.interpreter-svg {
  display: block;
  width: 100%;
  height: auto;
  overflow: visible;
  font-family: var(--font-sans);
}

/* 58px is one σ in the SVG from tools/build-art.mjs; the fallbacks are the z = 1 pose. */
.interpreter-svg__needle {
  translate: calc(var(--z, 1) * 58px) 0;
}

.interpreter-svg__dot {
  translate: 0 var(--lift, 66.1px);
}

.interpreter-svg__area {
  clip-path: inset(0 calc(100% - var(--cut, 62.5%)) 0 0);
}

/* The fill is painted on the input: WebKit does not reliably resolve custom properties in its track pseudo-element. */
.range {
  width: 100%;
  height: 2.75rem;
  cursor: pointer;
  -webkit-appearance: none;
  appearance: none;
  border-radius: 999px;
  background: linear-gradient(90deg, var(--color-primary) var(--fill, 66.7%), var(--color-border-soft) 0) 50% 50% / 100% 0.5rem no-repeat;
}

.range::-webkit-slider-runnable-track {
  height: 0.5rem;
  background: transparent;
}

.range::-moz-range-track {
  height: 0.5rem;
  background: transparent;
}

.range::-webkit-slider-thumb {
  width: 1.625rem;
  height: 1.625rem;
  margin-top: -0.5625rem;
  border: 3px solid var(--color-primary);
  border-radius: 999px;
  background: #fff;
  box-shadow: 0 6px 14px -4px rgba(15, 45, 82, 0.45);
  -webkit-appearance: none;
  appearance: none;
}

.range::-moz-range-thumb {
  width: 1.25rem;
  height: 1.25rem;
  border: 3px solid var(--color-primary);
  border-radius: 999px;
  background: #fff;
  box-shadow: 0 6px 14px -4px rgba(15, 45, 82, 0.45);
}

.range:focus-visible {
  outline: 2px solid var(--color-primary);
  outline-offset: 4px;
  border-radius: 999px;
}

.dots {
  display: grid;
  grid-template-columns: repeat(20, minmax(0, 1fr));
  gap: 5px;
}

.dot {
  aspect-ratio: 1;
  border-radius: 999px;
  background: var(--color-primary);
  opacity: calc(0.16 + 0.84 * clamp(0, var(--p, 84) - var(--i), 1));
}

.drawer,
.mobile-menu {
  translate: 100% 0;
  transition:
    translate 300ms var(--ease-standard),
    overlay 300ms allow-discrete,
    display 300ms allow-discrete;
}

.drawer[open],
.mobile-menu[open] {
  translate: 0 0;
}

.drawer::backdrop,
.mobile-menu::backdrop {
  background-color: rgba(15, 45, 82, 0);
  transition:
    background-color 300ms var(--ease-standard),
    overlay 300ms allow-discrete,
    display 300ms allow-discrete;
}

.drawer[open]::backdrop,
.mobile-menu[open]::backdrop {
  background-color: rgba(15, 45, 82, 0.5);
}

#login-note {
  opacity: 0;
  translate: 0 -0.25rem;
  transition:
    opacity 200ms var(--ease-standard),
    translate 200ms var(--ease-standard),
    overlay 200ms allow-discrete,
    display 200ms allow-discrete;
}

#login-note:popover-open {
  opacity: 1;
  translate: 0 0;
}

@starting-style {
  .drawer[open],
  .mobile-menu[open] {
    translate: 100% 0;
  }

  .drawer[open]::backdrop,
  .mobile-menu[open]::backdrop {
    background-color: rgba(15, 45, 82, 0);
  }

  #login-note:popover-open {
    opacity: 0;
    translate: 0 -0.25rem;
  }
}

/* Every animation is opted into here: with reduced motion the rules above are the static page. */
@media (prefers-reduced-motion: no-preference) {
  .hero-title__word {
    animation: focus-in 1000ms var(--ease-out-expo) both;
    animation-delay: calc(var(--i, 0) * 70ms + 60ms);
  }

  .rise-in {
    animation: rise-in 900ms var(--ease-out-expo) both;
    animation-delay: var(--d, 0ms);
  }

  .hero-photo {
    animation: hero-settle 2400ms var(--ease-out-expo) both;
  }

  [data-state="added"] svg {
    animation: check-pop 320ms var(--ease-spring);
  }

  .glow-border:focus-within::before {
    animation: angle-spin 1600ms var(--ease-out-expo) both;
  }

  /* Without scroll timelines these would run on the clock instead of the scroll. */
  @supports (animation-timeline: view()) {
    /* Longhands only: the animation shorthand resets animation-timeline. */
    .site-header::after {
      animation-name: read-progress;
      animation-duration: auto;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll(root block);
    }

    .hero-photo {
      animation-name: hero-settle, hero-drift;
      animation-duration: 2400ms, auto;
      animation-timing-function: var(--ease-out-expo), linear;
      animation-fill-mode: both, both;
      animation-timeline: auto, scroll(root block);
      animation-range: normal, 0 100vh;
    }

    .card-photo {
      animation-name: photo-settle;
      animation-duration: auto;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: view();
      animation-range: entry 0% cover 55%;
    }

    .reveal-word {
      animation-name: word-light;
      animation-duration: auto;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: view();
      animation-range: cover 28% cover 48%;
    }

    .bento-tile {
      animation-name: tile-rise;
      animation-duration: auto;
      animation-timing-function: var(--ease-out-expo);
      animation-fill-mode: both;
      animation-timeline: view();
      animation-range: entry var(--start, 0%) entry calc(var(--start, 0%) + 70%);
    }

    .span-ruler__range,
    .coverage-bar,
    .reach-bar {
      animation-name: grow-x;
      animation-duration: auto;
      animation-timing-function: var(--ease-out-expo);
      animation-fill-mode: both;
      animation-timeline: view();
      animation-range: entry var(--start, 30%) cover 50%;
    }

    .slide-in {
      animation-name: slide-in;
      animation-duration: auto;
      animation-timing-function: var(--ease-out-expo);
      animation-fill-mode: both;
      animation-timeline: view();
      animation-range: entry var(--start, 20%) cover 45%;
    }

    .count--view {
      animation-name: count-up;
      animation-duration: auto;
      animation-timing-function: var(--ease-out-expo);
      animation-fill-mode: both;
      animation-delay: 0ms;
      animation-timeline: view();
      animation-range: entry 10% cover 40%;
    }

    .reveal-rise {
      animation-name: reveal-rise;
      animation-duration: auto;
      animation-timing-function: var(--ease-out-expo);
      animation-fill-mode: both;
      animation-timeline: view();
      animation-range: entry 0% entry 90%;
    }

    [data-grid] > li {
      animation-name: card-rise;
      animation-duration: auto;
      animation-timing-function: var(--ease-out-expo);
      animation-fill-mode: both;
      animation-timeline: view();
      animation-range: entry 0% entry 70%;
    }

    .mega-tagline {
      animation-name: fill-up;
      animation-duration: auto;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: view();
      animation-range: entry 20% cover 50%;
    }
  }
}

@keyframes focus-in {
  from {
    opacity: 0.12;
    translate: 0 0.3em;
  }
}

@keyframes rise-in {
  from {
    opacity: 0;
    translate: 0 1.75rem;
  }
}

@keyframes hero-settle {
  from {
    scale: 1.08;
  }
}

@keyframes hero-drift {
  to {
    translate: 0 14%;
  }
}

@keyframes count-up {
  from {
    --count: 0;
  }
}

@keyframes check-pop {
  from {
    opacity: 0;
    scale: 0.4;
  }
}

@keyframes angle-spin {
  from {
    --angle: 0deg;
  }

  to {
    --angle: 360deg;
  }
}

@keyframes read-progress {
  to {
    scale: 1 1;
  }
}

@keyframes reveal-rise {
  from {
    translate: 0 0.6em;
  }
}

@keyframes card-rise {
  from {
    translate: 0 4rem;
    scale: 0.94;
  }
}

@keyframes fill-up {
  from {
    --fill: 0%;
  }
}

@keyframes photo-settle {
  from {
    transform: scale(1.18);
  }
}

/* 3.92:1 on ink-deep: large-text AA before the word lights up. */
@keyframes word-light {
  from {
    color: #62809f;
  }
}

@keyframes tile-rise {
  from {
    translate: 0 3.5rem;
    scale: 0.96;
  }
}

@keyframes grow-x {
  from {
    scale: 0 1;
  }
}

@keyframes slide-in {
  from {
    translate: 2.5rem 0;
  }
}

@keyframes card-enter {
  from {
    opacity: 0;
    scale: 0.9;
  }
}

@keyframes card-leave {
  to {
    opacity: 0;
    scale: 0.9;
  }
}
}
