// span 4 + subgrid: media, head, details and purchase line up across the cards of a row.
.product-card
  grid-row: span 4
  display: grid
  grid-template-rows: subgrid
  overflow: hidden
  border-radius: var(--radius-lg)
  border: 1px solid var(--color-border-soft)
  background-color: var(--color-surface)
  box-shadow: var(--shadow-card)
  transition-property: translate, box-shadow, border-color
  transition-duration: 300ms
  transition-timing-function: var(--ease-standard)
  &:focus-within
    translate: 0 -0.125rem
    box-shadow: var(--shadow-card-hover)
  +hover()
    translate: 0 -0.125rem
    border-color: #b6cbe4
    box-shadow: var(--shadow-card-hover)

  &__media
    position: relative
    aspect-ratio: 3 / 2
    overflow: hidden
    background-color: var(--color-primary-tint)

  &__image
    width: 100%
    height: 100%
    object-fit: cover
    color: transparent // no alt-text flash while the image loads
    transition-property: transform, translate, scale, rotate
    transition-duration: 500ms
    transition-timing-function: var(--ease-standard)
    @media (hover: hover)
      ^[0]:hover &
        scale: 1.03

  &__picture
    display: contents

  &__discount
    position: absolute
    top: 0.75rem
    right: 0.75rem
    border-radius: var(--radius-pill)
    background-color: var(--color-surface)
    padding: 0.125rem 0.5rem
    t-xs()
    font-weight: 700
    font-variant-numeric: tabular-nums
    color: var(--color-success)
    box-shadow: $shadow-sm

  &__badge
    position: absolute
    top: 0.75rem
    left: 0.75rem

  &__head
    display: flex
    min-width: 0
    flex-direction: column
    gap: 0.375rem
    padding: 0.25rem 1.25rem 0

  &__title
    color: var(--color-ink)

  &__code
    display: block
    t-xs()
    font-weight: 600
    letter-spacing: 0.14em
    text-transform: uppercase
    color: var(--color-accent-strong)

  &__name
    margin-top: 0.25rem
    display: block
    font-family: var(--font-display)
    font-size: 1.1875rem
    line-height: 1.375
    font-weight: 600
    text-wrap: balance

  // Clipped visually only: the full byline stays in the text and the title attribute.
  &__author
    overflow: hidden
    text-overflow: ellipsis
    white-space: nowrap
    t-sm()
    color: var(--color-muted)

  &__details
    padding-right: 1.25rem
    padding-left: 1.25rem

  &__purchase
    display: flex
    align-items: flex-end
    justify-content: space-between
    gap: 0.75rem
    border-top: 1px solid var(--color-border-soft)
    padding: 1rem 1.25rem 1.25rem

  &__add
    flex-shrink: 0
