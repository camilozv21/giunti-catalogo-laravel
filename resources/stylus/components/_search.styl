.search
  position: relative
  width: 100%

  &__icon
    pointer-events: none
    position: absolute
    top: 50%
    left: 0.875rem
    translate: 0 -50%
    color: var(--color-muted)

  &__input
    height: 2.75rem
    width: 100%
    border-radius: var(--radius-pill)
    border: 1px solid var(--color-border-control)
    background-color: var(--color-surface)
    padding-right: 2.75rem
    padding-left: 2.5rem
    font-size: 0.9375rem
    color: var(--color-ink)
    transition-colors()
    &::placeholder
      color: var(--color-muted)
    &::-webkit-search-cancel-button
      appearance: none
    +hover()
      border-color: var(--color-primary)
    &:focus
      border-color: var(--color-primary)

  &__clear
    position: absolute
    top: 50%
    right: 0.375rem
    display: inline-flex
    width: 2rem
    height: 2rem
    translate: 0 -50%
    cursor: pointer
    align-items: center
    justify-content: center
    border-radius: 9999px
    color: var(--color-muted)
    +hover()
      background-color: var(--color-primary-tint)
      color: var(--color-ink)

.search__results
  display: flex
  flex-direction: column
  gap: 0.125rem

.search__option
  display: flex
  cursor: pointer
  align-items: center
  gap: 0.75rem
  border-radius: 0.75rem
  padding: 0.5rem 0.625rem
  &[aria-selected="true"]
    background-color: var(--color-primary-tint)

.search__thumb
  position: relative
  width: 3rem
  height: 2.25rem
  flex-shrink: 0
  overflow: hidden
  border-radius: var(--radius-md)
  background-color: var(--color-primary-tint)
  img
    position: absolute
    inset: 0
    width: 100%
    height: 100%
    object-fit: cover
    color: transparent

.search__text
  min-width: 0
  flex: 1

.search__meta
  display: block
  overflow: hidden
  text-overflow: ellipsis
  white-space: nowrap

.search__name
  display: -webkit-box
  overflow: hidden
  -webkit-box-orient: vertical
  -webkit-line-clamp: 2
  t-sm()
  line-height: 1.375
  font-weight: 600
  color: var(--color-ink)

.search__meta
  t-xs()
  color: var(--color-muted)

.search__price
  flex-shrink: 0
  t-sm()
  font-weight: 600
  font-variant-numeric: tabular-nums
  color: var(--color-ink)

.search__none
  padding: 0.625rem 0.75rem
  t-sm()
  color: var(--color-muted)
