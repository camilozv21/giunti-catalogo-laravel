// The section slides under the sticky header so the photo covers the whole viewport: Chrome then treats it as a
// background, and the headline, painted in the first frame, is the Largest Contentful Paint.
.hero
  position: relative
  isolation: isolate
  display: flex
  margin-top: unquote('calc(var(--header-block) * -1)')
  min-height: 100svh
  align-items: flex-end
  overflow: clip
  background-color: var(--color-ink-deep)
  color: #fff

  &__picture
    display: contents

  &__photo
    position: absolute
    inset: 0
    z-index: -20
    width: 100%
    height: 100%
    object-fit: cover
    object-position: 25% 30%
    +mq(md)
      object-position: 50% 30%
    color: transparent

  &__inner
    padding-top: unquote('calc(10rem + var(--header-block))')
    padding-bottom: 3.5rem
    +mq(md)
      padding-bottom: 5rem

  &__title
    max-width: 56rem
    font-family: var(--font-display)
    t-token(display)
    font-weight: 600
    text-wrap: balance

  &__lead
    margin-top: 1.5rem
    max-width: 36rem
    t-token(lead)
    text-wrap: pretty
    color: var(--color-ink-soft)

  &__actions
    margin-top: 2.25rem

// Rendered in the footer (partials/trust-strip), not in the hero.
.trust
  margin-top: 3rem
  display: grid
  gap: 1.5rem
  border-top: 1px solid rgba(255, 255, 255, 0.12)
  padding-top: 2rem
  +mq(sm)
    grid-template-columns: repeat(3, minmax(0, 1fr))
    gap: 2rem
  +mq(md)
    margin-top: 4rem

  &__item
    display: flex
    flex-direction: column
    gap: 0.25rem

  &__value
    font-family: var(--font-display)
    font-size: unquote('clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem)')
    line-height: 1.25
    font-weight: 600
    letter-spacing: -0.025em
    color: #fff

  &__text
    t-sm()
    color: var(--color-ink-muted)
