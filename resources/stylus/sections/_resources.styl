.resources
  background-color: var(--color-surface)
  padding-top: 5rem
  padding-bottom: 5rem
  +mq(md)
    padding-top: 7rem
    padding-bottom: 7rem

  &__inner
    display: grid
    gap: 3rem
    +mq(lg)
      grid-template-columns: minmax(0, 0.75fr) minmax(0, 2fr)
      gap: 3.5rem

  &__levels
    display: grid
    gap: 1rem
    +mq(sm)
      grid-template-columns: repeat(2, minmax(0, 1fr))
    +mq(xl)
      grid-template-columns: repeat(4, minmax(0, 1fr))

.qualification
  display: flex
  flex-direction: column
  gap: 1.25rem
  border-radius: 1rem
  border: 1px solid var(--color-border-soft)
  background-color: var(--color-page)
  padding: 1.5rem

  &__code
    font-family: var(--font-display)
    font-size: 3rem
    line-height: 1
    font-weight: 600
    letter-spacing: -0.025em
    color: var(--color-ink)

  &__text
    t-sm()
    color: var(--color-ink)

  &__reach
    margin-top: auto
    display: flex
    flex-direction: column
    gap: 0.625rem

  &__share
    t-sm()
    font-weight: 600
    color: var(--color-primary)

  &__tests
    t-xs()
    line-height: 1.625
    color: var(--color-muted)
