// Mirrors the Next.js version: change both together.
// Custom properties sit in an @css block so Stylus never evaluates clamp()/min()/linear().
$bp = { sm: 40rem, md: 48rem, lg: 64rem, xl: 80rem }

@css {
  :root {
    --color-primary: #1B4F8A;
    --color-primary-strong: #143B68;
    --color-primary-tint: #E3ECF7;
    --color-ink: #0F2D52;
    --color-ink-deep: #0A2140;
    --color-ink-soft: #BFDBFE;
    --color-ink-muted: #A9C1DD;
    --color-accent: #0EA5E9;
    --color-accent-strong: #0369A1;
    --color-accent-soft: #7DD3FC;
    --color-page: #EFF6FF;
    --color-surface: #FFFFFF;
    --color-muted: #4A6585;
    --color-border-soft: #C9DAEE;
    --color-border-control: #6D8CB3;
    --color-sky-tint: #E0F2FE;
    --color-success: #067647;
    --color-success-tint: #ECFDF3;
    --color-danger: #B42318;
    --color-danger-tint: #FEF3F2;
    --color-grid-line: rgba(27, 79, 138, 0.08);
    --radius-sm: 0.5rem;
    --radius-md: 0.75rem;
    --radius-lg: 1rem;
    --radius-pill: 999px;
    --shadow-card: 0 1px 2px rgba(15, 45, 82, 0.06), 0 1px 3px rgba(15, 45, 82, 0.08);
    --shadow-card-hover: 0 14px 32px -14px rgba(15, 45, 82, 0.30), 0 4px 10px -4px rgba(15, 45, 82, 0.12);
    --shadow-header: 0 1px 0 rgba(15, 45, 82, 0.08), 0 10px 24px -18px rgba(15, 45, 82, 0.35);
    --shadow-drawer: -24px 0 48px -24px rgba(15, 45, 82, 0.35);
    --shadow-fab: 0 10px 24px -8px rgba(10, 33, 64, 0.45), 0 2px 6px rgba(10, 33, 64, 0.2);
    --text-display: clamp(2.75rem, 1.25rem + 5vw, 5.75rem);
    --text-display--line-height: 0.98;
    --text-display--letter-spacing: -0.035em;
    --text-h2: clamp(2rem, 1.35rem + 2.6vw, 3.5rem);
    --text-h2--line-height: 1.05;
    --text-h2--letter-spacing: -0.03em;
    --text-h3: 1.25rem;
    --text-h3--line-height: 1.3;
    --text-h3--letter-spacing: -0.01em;
    --text-lead: clamp(1.0625rem, 1rem + 0.35vw, 1.25rem);
    --text-lead--line-height: 1.6;
    --text-lead--letter-spacing: 0;
    --text-body: 1rem;
    --text-body--line-height: 1.6;
    --text-body--letter-spacing: 0;
    --text-small: 0.875rem;
    --text-small--line-height: 1.5;
    --text-small--letter-spacing: 0;
    --text-xs: 0.75rem;
    --text-xs--line-height: 1.4;
    --text-xs--letter-spacing: 0.02em;
    --font-display: "Fraunces", Georgia, 'Times New Roman', serif;
    --font-sans: "Inter", system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
    --ease-standard: cubic-bezier(0.2, 0.8, 0.2, 1);
    --ease-spring: linear(0, 0.18 6%, 0.6 18%, 0.92 30%, 1.03 40%, 1.02 52%, 1);
    --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
    --ease-bounce: linear(0, 0.22 5%, 0.74 15%, 1.06 24%, 1.11 30%, 1.05 38%, 0.98 47%, 1.01 60%, 1);
    --duration-fast: 150ms;
    --duration-base: 250ms;
    --duration-slow: 400ms;
    --container-page: 77.5rem;
    --gutter: clamp(1rem, 0.5rem + 2vw, 2rem);
    --header-height: 4.5rem;
    --header-height-compact: 7rem;
  }
}
