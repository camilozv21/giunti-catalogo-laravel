{
	frankenphp
	admin off
	auto_https off
}

# The platform injects PORT and terminates TLS at its proxy.
:{$PORT:8080} {
	root * /app/public
	encode zstd br gzip

	# Mix appends ?id=<hash> to these URLs, so they can be immutable.
	@versioned path /css/* /js/*
	header @versioned Cache-Control "public, max-age=31536000, immutable"

	@static path /fonts/* /images/* /icons/* /favicon.svg /favicon.ico /apple-touch-icon.png /manifest.webmanifest
	header @static Cache-Control "public, max-age=604800, stale-while-revalidate=86400"

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	php_server
}
